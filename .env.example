# ============================================================
# Muse AI-Terminal Configuration
# Copy this file to .env and fill in your values
# ============================================================

# ========== Model Provider ==========
# Provider type: qoder | openai
# - qoder:  复用本机 Qoder CLI（qodercli）的登录与额度，零密钥（默认，可不配置）
# - openai: OpenAI-compatible API (OpenAI, DeepSeek, Ollama, vLLM, etc.)
MUSE_MODEL_PROVIDER=qoder

# --- OpenAI Compatible Provider（仅 MUSE_MODEL_PROVIDER=openai 时生效）---
# Works with: OpenAI, DeepSeek, Ollama, vLLM, LiteLLM, any OpenAI-compatible endpoint
# MUSE_API_KEY=sk-your-api-key
# MUSE_API_BASE_URL=https://api.openai.com/v1
# MUSE_MODEL=gpt-4o

# --- Ollama (Local, Free) ---
# MUSE_MODEL_PROVIDER=openai
# MUSE_API_BASE_URL=http://localhost:11434/v1
# MUSE_API_KEY=ollama
# MUSE_MODEL=qwen2.5-coder

# --- DeepSeek ---
# MUSE_MODEL_PROVIDER=openai
# MUSE_API_BASE_URL=https://api.deepseek.com/v1
# MUSE_API_KEY=your-deepseek-key
# MUSE_MODEL=deepseek-coder

# --- Qoder CLI (本机 qodercli，零密钥，需先 qodercli login) ---
# MUSE_MODEL_PROVIDER=qoder
# MUSE_QODER_MODEL=          # 可选：指定模型，缺省用 qodercli 默认
# MUSE_QODER_BIN=qodercli    # 可选：qodercli 可执行文件路径

# ========== Optional: DingTalk Integration ==========
MUSE_DINGTALK_ENABLED=false
# MUSE_DINGTALK_WEBHOOK=https://oapi.dingtalk.com/robot/send?access_token=xxx
# MUSE_DINGTALK_OUTGOING_PORT=8080

# ========== Optional: Skill Market & Hub ==========
# Skill market index URL (defaults to GitHub repo)
# MUSE_SKILL_MARKET_URL=https://raw.githubusercontent.com/muse-ai-terminal/skill-market/main/index.json
# SkillHub CLI install URL
# MUSE_SKILLHUB_INSTALL_URL=https://raw.githubusercontent.com/muse-ai-terminal/skillhub-cli/main/install.sh

# ========== Optional: User Identity ==========
# Used for AI skill generation (was hardcoded, now configurable)
# MUSE_EMP_ID=your-employee-id
